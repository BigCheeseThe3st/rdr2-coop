<Project Sdk="Microsoft.NET.Sdk">
  <!-- The network tests under dotnet (build.sh also runs them under mono): dotnet tests/bin/Release/net9.0/NetTests.dll, from the repo root. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>SYSLIB0014;SYSLIB0021</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseAppHost>false</UseAppHost>   <!-- no Linux apphost; run through dotnet -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Net/*.cs;*.cs" />
  </ItemGroup>
</Project>
